---
import Link from '../core/link.astro';

type Props = {
	href: string;
	label?: string;
	title?: string;
};

const { href, label = 'source', title } = Astro.props;
---

<sup class="ml-[0.08em] select-none align-super font-mono text-[0.68em] leading-none not-italic selection:bg-transparent selection:text-muted">
	<Link class="font-mono text-muted no-underline" href={href} showIcon={false} showArrow={false} aria-label={title ?? `Citation: ${label}`}>
		{label}
	</Link>
</sup>
