---
import { parseMediaSources } from '../../lib/media';

type Props = {
	src: string | string[];
	alt?: string;
	caption?: string;
	credit?: string;
	fit?: 'cover' | 'contain';
	loading?: 'lazy' | 'eager';
	autoplay?: boolean;
	controls?: boolean;
	loop?: boolean;
	muted?: boolean;
};

const {
	src,
	alt = '',
	caption,
	credit,
	fit = 'cover',
	loading = 'lazy',
	autoplay = true,
	controls = false,
	loop = true,
	muted = true,
} = Astro.props;

const sources = parseMediaSources(src);
const totalRatio = sources.reduce((sum, item) => sum + item.ratio, 0);
const shouldShowControls = controls || !autoplay;
const figureStyle = [
	`--media-ratio:${totalRatio}`,
	'width:min(calc(100vw - (var(--space-page) * 2)), var(--measure-media))',
	'margin-inline:calc((100% - min(calc(100vw - (var(--space-page) * 2)), var(--measure-media))) / 2)',
].join(';');
---

<figure class="my-(--space-5) grid gap-(--space-2)" style={figureStyle} data-count={sources.length}>
	<div class="flex w-full overflow-hidden bg-surface max-[42rem]:grid max-[42rem]:[aspect-ratio:auto]" style="aspect-ratio:var(--media-ratio);">
		{
			sources.map((item) => (
				<div
					class="relative grid min-w-0 shrink-0 place-items-center overflow-hidden rounded-(--radius-thin) max-[42rem]:w-full max-[42rem]:[flex-basis:auto!important]"
					style={`--item-ratio:${item.ratio}; --item-basis:${(item.ratio / totalRatio) * 100}%; flex-basis:var(--item-basis); aspect-ratio:var(--item-ratio);`}
					data-media-item
					data-alt={alt || undefined}
				>
					{item.kind === 'video' ? (
						<>
							<video
								class="block size-full object-cover pointer-events-none data-[fit=contain]:object-contain"
								data-media-video
								data-media-asset
								data-src={item.url}
								data-autoplay={autoplay ? 'true' : 'false'}
								data-fit={fit}
								aria-label={alt || undefined}
								preload="none"
								muted={muted}
								loop={loop}
								playsinline
								controls={shouldShowControls}
								crossorigin="anonymous"
							/>
							<noscript>
								<video
									class="block size-full object-cover pointer-events-none data-[fit=contain]:object-contain"
									src={item.url}
									data-media-asset
									data-fit={fit}
									aria-label={alt || undefined}
									preload="metadata"
									muted
									loop={loop}
									playsinline
									controls
									crossorigin="anonymous"
								/>
							</noscript>
						</>
					) : (
						<img
							class="block size-full object-cover pointer-events-none select-none data-[fit=contain]:object-contain"
							src={item.url}
							width={item.width}
							height={item.height}
							alt={alt}
							loading={loading}
							decoding="async"
							crossorigin="anonymous"
							referrerpolicy="origin"
							data-fit={fit}
							data-media-asset
							draggable="false"
						/>
					)}
				</div>
			))
		}
	</div>
	{
		(caption || credit) && (
			<figcaption class="flex flex-wrap gap-x-(--space-2) gap-y-(--space-1) text-(length:--type-label) leading-(--leading-label) text-muted">
				{caption && <span>{caption}</span>}
				{credit && <span>{credit}</span>}
			</figcaption>
		)
	}
</figure>
