---
import { render } from 'astro:content';
import type { ArtifactEntry } from '../../lib/artifacts';
import Link from '../core/link.astro';
import MdxCitation from './citation.astro';
import MdxMedia from './media.astro';
import MdxParagraph from './paragraph.astro';
import MdxQuote from './quote.astro';
import MdxSpacer from './spacer.astro';

type Props = {
	entry: ArtifactEntry;
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const components = {
	a: Link,
	Citation: MdxCitation,
	Link: Link,
	Media: MdxMedia,
	MdxCitation,
	MdxMedia,
	MdxParagraph,
	MdxQuote,
	MdxSpacer,
	Paragraph: MdxParagraph,
	Quote: MdxQuote,
	Spacer: MdxSpacer,
};
---

<article class="grid max-w-(--measure-article) gap-(--space-5)" data-prose data-line-reveal-group="article-content">
	<Content components={components} />
</article>
