---
import { parseMediaSources } from '../../lib/media';

type MediaDescription = { alt: string; decorative?: false } | { alt?: never; decorative: true };

type Props = MediaDescription & {
	src: string | string[];
	caption?: string;
	credit?: string;
	fit?: 'cover' | 'contain';
	loading?: 'lazy' | 'eager';
	fetchPriority?: 'high' | 'low' | 'auto';
};

const {
	src,
	alt = '',
	decorative = false,
	caption,
	credit,
	fit = 'cover',
	loading = 'lazy',
	fetchPriority,
} = Astro.props;

if (!decorative && alt.trim().length === 0) {
	throw new Error('MdxMedia requires descriptive alt text or an explicit decorative prop');
}

const sources = parseMediaSources(src);
const resolvedFetchPriority = fetchPriority ?? (loading === 'eager' ? 'high' : undefined);
const totalRatio = sources.reduce((sum, item) => sum + item.ratio, 0);
const mediaAssetClass = 'block size-full object-cover select-none data-[fit=contain]:object-contain';
const passiveMediaAssetClass = `${mediaAssetClass} pointer-events-none`;
const figureStyle = [
	`--media-ratio:${totalRatio}`,
	'--render-skip-intrinsic-size:calc(min(calc(100vw - (var(--space-page) * 2)), var(--measure-media)) / var(--media-ratio))',
	'width:min(calc(100vw - (var(--space-page) * 2)), var(--measure-media))',
	'margin-inline:calc((100% - min(calc(100vw - (var(--space-page) * 2)), var(--measure-media))) / 2)',
].join(';');
---

<figure class="my-(--space-5) grid min-w-0 gap-(--space-2)" style={figureStyle} data-count={sources.length} data-reveal data-render-skip="auto">
	<div class="flex w-full overflow-hidden bg-surface max-[42rem]:grid max-[42rem]:[aspect-ratio:auto]" style="aspect-ratio:var(--media-ratio);" data-media-frame>
		{
			sources.map((item) => (
				<div
					class="relative grid min-w-0 shrink-0 place-items-center overflow-hidden rounded-(--radius-thin) max-[42rem]:w-full max-[42rem]:[flex-basis:auto!important]"
					style={`--item-ratio:${item.ratio}; --item-basis:${(item.ratio / totalRatio) * 100}%; flex-basis:var(--item-basis); aspect-ratio:var(--item-ratio);`}
					data-media-item
						data-alt={alt || 'Media unavailable'}
				>
					{item.kind === 'video' ? (
						<video
							class={passiveMediaAssetClass}
							src={item.displayUrl}
							data-media-video
							data-media-asset
							data-src={item.displayUrl}
							data-autoplay="true"
							data-fit={fit}
							aria-label={alt || 'Decorative animation'}
							preload="none"
							poster={item.posterUrl}
							muted
							loop
							playsinline
							crossorigin="anonymous"
							draggable="false"
						/>
					) : (
						<img
							class={passiveMediaAssetClass}
							src={item.displayUrl}
							srcset={item.srcset}
							sizes={item.sizes}
							width={item.width}
							height={item.height}
							alt={alt}
							loading={loading}
							fetchpriority={resolvedFetchPriority}
							decoding="async"
							crossorigin="anonymous"
							referrerpolicy="origin"
							data-fit={fit}
							data-media-asset
							draggable="false"
						/>
					)}
				</div>
			))
		}
	</div>
	{
		(caption || credit) && (
			<figcaption class="flex flex-wrap gap-x-(--space-2) gap-y-(--space-1) text-(length:--type-label) leading-(--leading-label) text-muted">
				{caption && <span>{caption}</span>}
				{credit && <span>{credit}</span>}
			</figcaption>
		)
	}
</figure>
