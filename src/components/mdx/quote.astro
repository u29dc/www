---
type Props = {
	author?: string;
	source?: string;
	reference?: string;
	href?: string;
};

const { author, source, reference, href } = Astro.props;
const hasCaption = Boolean(author || source || reference);
const isExternal = href ? /^https?:\/\//.test(href) : false;
---

<figure class="grid gap-(--space-3) border-l border-edge pl-(--space-4)">
	<blockquote class="font-serif-condensed text-(length:--type-quote) font-(--weight-title) leading-(--leading-title)">
		<slot />
	</blockquote>
	{
		hasCaption && (
			<figcaption class="flex flex-wrap gap-x-(--space-2) gap-y-(--space-1) text-(length:--type-label) leading-(--leading-label) text-muted">
				{author && <span>{author}</span>}
				{source && <span>{source}</span>}
				{reference &&
					(href ? (
						<a class="text-current decoration-muted/45 underline-offset-[0.18em]" href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
							{reference}
						</a>
					) : (
						<span>{reference}</span>
					))}
			</figcaption>
		)
	}
</figure>
