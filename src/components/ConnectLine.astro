---
import AtomicBrandLogo from './AtomicBrandLogo.astro';
import UiLink from './UiLink.astro';
import { connectLinks } from '../lib/site-content';
---

<footer class="grid gap-(--space-4) pt-(--space-4)" id="connect">
	<p class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted">Connect</p>
	<div class="connect-copy max-w-(--measure-article) text-(length:--type-body-lg) leading-(--leading-body) text-muted [&_.ui-link]:font-(--weight-strong) [&_.ui-link]:text-ink">
		<p class="connect-copy__line">
			<span class="connect-indicator" aria-hidden="true"></span>
			<UiLink href={connectLinks.conversation.href} icon={connectLinks.conversation.icon}>Book a call</UiLink><span class="copy-skip">, </span>follow and connect on <UiLink href={connectLinks.linkedin.href} icon={connectLinks.linkedin.icon}>LinkedIn</UiLink> and <UiLink href={connectLinks.instagram.href} icon={connectLinks.instagram.icon}>Instagram</UiLink>
		</p>
		<p>
			or write to <UiLink href={connectLinks.email.href} icon={connectLinks.email.icon}>han@u29dc.com</UiLink>
		</p>
	</div>
	<AtomicBrandLogo
		class='my-(--space-4)'
		width={100}
		mobileWidth={100}
		noiseIntensity={0.1}
		noiseScale={0.5}
		defaultBlurIntensity={0.40}
		blurStart={1.5}
		mouseBlurIntensity={0.25}
		mobileMouseBlurIntensity={0.3}
		mouseBlurSize={0.3}
		mobileMouseBlurSize={0.2}
	/>
</footer>
