---
import { ArrowUpRight, Calendar, Code, File, Globe, Layers, Mail, Mic, Play, Rss } from '@lucide/astro';
import type { AstroComponent } from '@lucide/astro';
import { SITE } from '../lib/constants';
import { resolveLinkHoverPreview, type HoverPreviewFit } from '../lib/hover-preview';
import type { LinkIcon, LinkMark } from '../lib/links';

type Props = {
	href?: string;
	icon?: LinkIcon;
	mark?: LinkMark;
	external?: boolean;
	showIcon?: boolean;
	showArrow?: boolean;
	previewMedia?: string;
	previewAlt?: string;
	previewFit?: HoverPreviewFit;
	class?: string;
	target?: string;
	rel?: string;
	[key: string]: unknown;
};

const DEFAULT_LINK_PREVIEW_MEDIA: readonly string[] = [];

const firstDefaultLinkPreviewMedia = (): string | undefined => DEFAULT_LINK_PREVIEW_MEDIA[0];

const {
	href = '#',
	icon,
	mark,
	external,
	showIcon,
	showArrow = true,
	previewMedia,
	previewAlt,
	previewFit,
	class: className,
	target,
	rel,
	...anchorProps
} = Astro.props as Props;

const parseUrl = (value: string): URL | null => {
	try {
		return new URL(value, SITE.url);
	} catch {
		return null;
	}
};

const parsedUrl = parseUrl(href);
const protocol = parsedUrl?.protocol ?? '';
const host = parsedUrl?.hostname.replace(/^www\./, '') ?? '';
const isHttp = protocol === 'http:' || protocol === 'https:';
const isMail = protocol === 'mailto:';
const isExternal = external ?? (isHttp && parsedUrl?.origin !== SITE.url);
const isFootnote = 'data-footnote-ref' in anchorProps || 'data-footnote-backref' in anchorProps;

const iconFromHref = (): LinkIcon => {
	if (isMail) return 'mail';
	if (host === 'youtube.com' || host === 'youtu.be') return 'youtube';
	if (host === 'cal.com') return 'calendar';
	if (host.includes('github.com')) return 'code';
	if (href.endsWith('.pdf') || href.endsWith('.md') || href.endsWith('.txt')) return 'file';
	if (isExternal) return 'globe';
	return 'file';
};

const activeIcon = icon ?? iconFromHref();
const shouldRenderIcon = (showIcon ?? Boolean(icon ?? mark)) && !isFootnote;
const shouldRenderArrow = showArrow && isExternal && !isFootnote;
const targetValue = isExternal ? (target ?? '_blank') : target;
const relValue = isExternal ? Array.from(new Set([rel, 'noopener', 'noreferrer'].filter(Boolean))).join(' ') : rel;
const activePreviewMedia = previewMedia ?? firstDefaultLinkPreviewMedia();
const preview = resolveLinkHoverPreview(activePreviewMedia, {
	...(previewAlt === undefined ? {} : { alt: previewAlt }),
	...(previewFit === undefined ? {} : { fit: previewFit }),
});

const iconComponents: Record<LinkIcon, AstroComponent> = {
	arrow: ArrowUpRight,
	calendar: Calendar,
	code: Code,
	file: File,
	globe: Globe,
	layers: Layers,
	mail: Mail,
	mic: Mic,
	play: Play,
	rss: Rss,
	youtube: Play,
};
const ActiveIcon = iconComponents[activeIcon];

const markImages: Partial<Record<LinkMark, string>> = {
	lotus: '/assets/marks/lotus.webp',
	lusion: '/assets/marks/lusion.webp',
	nohlab: '/assets/marks/nohlab.webp',
	porsche: '/assets/marks/porsche.webp',
	salon: '/assets/marks/salon.webp',
};

const markClasses: Record<LinkMark, string> = {
	infinity: 'bg-ink',
	lotus: 'bg-[oklch(96.86%_0.2046_109.77)]',
	lusion: 'bg-[oklch(28%_0.004_250)]',
	nohlab: 'bg-[oklch(42.32%_0.2896_265.17)]',
	porsche: 'bg-[oklch(36%_0.004_250)]',
	salon: 'bg-[oklch(36%_0.004_250)]',
};
---

<span class:list={['inline leading-[inherit]', className]}>
	<a
		class="group/link inline text-current no-underline decoration-muted/45 underline-offset-[0.18em] leading-[inherit] transition-colors duration-(--duration-quick) ease-(--ease-settle) hover:text-ink"
		href={href}
		target={targetValue}
		rel={relValue}
		data-hover-preview-target={preview ? 'link' : undefined}
		data-hover-preview-src={preview?.url}
		data-hover-preview-kind={preview?.kind}
		data-hover-preview-ratio={preview?.ratio}
		data-hover-preview-fit={preview?.fit}
		data-hover-preview-alt={preview?.alt}
		{...anchorProps}
	>
		<span class="relative inline-block min-w-0 leading-[inherit] group-hover/link:underline"><slot /></span>
		{
			shouldRenderIcon && (
				<span class="ml-[0.12em] inline-block size-[0.98em] select-none align-[-0.14em] text-muted transition-colors duration-(--duration-quick) ease-(--ease-settle) [line-height:0] selection:bg-transparent selection:text-muted group-hover/link:text-ink" aria-hidden="true">
					{mark ? (
						markImages[mark] ? (
							<img class="block size-full rounded-none object-contain select-none pointer-events-none" src={markImages[mark]} alt="" width="64" height="64" decoding="async" draggable="false" />
						) : (
							<span class:list={['block size-full rounded-full', markClasses[mark]]} />
						)
					) : (
						<ActiveIcon class="block size-full pointer-events-none" stroke-width={2.35} focusable="false" />
					)}
				</span>
			)
		}
		{
			shouldRenderArrow && (
				<ArrowUpRight
					class="ml-[0.06em] inline-block size-[0.72em] select-none align-[0.08em] text-muted transition-[color,transform] duration-(--duration-quick) ease-(--ease-settle) selection:bg-transparent selection:text-muted group-hover/link:translate-x-[0.08em] group-hover/link:translate-y-[-0.08em] group-hover/link:text-ink"
					stroke-width={2.25}
					aria-hidden="true"
					focusable="false"
				/>
			)
		}
	</a>
</span>
