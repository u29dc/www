---
import { render } from 'astro:content';
import type { ArtifactEntry } from '../lib/content';
import Link from './Link.astro';
import MdxCitation from './mdx/MdxCitation.astro';
import MdxMedia from './mdx/MdxMedia.astro';
import MdxParagraph from './mdx/MdxParagraph.astro';
import MdxQuote from './mdx/MdxQuote.astro';
import MdxSpacer from './mdx/MdxSpacer.astro';

type Props = {
	entry: ArtifactEntry;
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const components = {
	a: Link,
	Citation: MdxCitation,
	Link: Link,
	Media: MdxMedia,
	MdxCitation,
	MdxMedia,
	MdxParagraph,
	MdxQuote,
	MdxSpacer,
	Paragraph: MdxParagraph,
	Quote: MdxQuote,
	Spacer: MdxSpacer,
};
---

<article class="grid max-w-(--measure-article) gap-(--space-5)" data-prose data-reveal>
	<Content components={components} />
</article>
