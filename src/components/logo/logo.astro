---
type Props = {
	width?: number;
	mobileWidth?: number;
	blurStart?: number;
	defaultBlurIntensity?: number;
	mouseBlurIntensity?: number;
	mobileMouseBlurIntensity?: number;
	mouseBlurSize?: number;
	mobileMouseBlurSize?: number;
	roundness?: number;
	noiseIntensity?: number;
	noiseScale?: number;
	class?: string;
	theme?: 'light' | 'dark' | 'system';
	enableObservation?: boolean;
};

const {
	width = 200,
	mobileWidth,
	blurStart = 1.0,
	defaultBlurIntensity = 0.5,
	mouseBlurIntensity = 1.0,
	mobileMouseBlurIntensity,
	mouseBlurSize = 0.5,
	mobileMouseBlurSize,
	roundness = 0.5,
	noiseIntensity = 0.15,
	noiseScale = 150,
	class: className = '',
	theme = 'system',
	enableObservation = true,
} = Astro.props;

const resolvedMobileWidth = mobileWidth ?? width;
const height = width / 2;
const mobileHeight = resolvedMobileWidth / 2;
const style = [
	`--logo-width:${width}px`,
	`--logo-height:${height}px`,
	`--logo-mobile-width:${resolvedMobileWidth}px`,
	`--logo-mobile-height:${mobileHeight}px`,
]
	.filter(Boolean)
	.join(';');
---

<div
	class:list={['block overflow-visible w-(--logo-width) h-(--logo-height) max-[42rem]:w-(--logo-mobile-width) max-[42rem]:h-(--logo-mobile-height)', className]}
	style={style}
	data-logo
	data-width={width}
	data-mobile-width={resolvedMobileWidth}
	data-blur-start={blurStart}
	data-default-blur-intensity={defaultBlurIntensity}
	data-mouse-blur-intensity={mouseBlurIntensity}
	data-mobile-mouse-blur-intensity={mobileMouseBlurIntensity ?? mouseBlurIntensity}
	data-mouse-blur-size={mouseBlurSize}
	data-mobile-mouse-blur-size={mobileMouseBlurSize ?? mouseBlurSize}
	data-roundness={roundness}
	data-noise-intensity={noiseIntensity}
	data-noise-scale={noiseScale}
	data-theme={theme}
	data-enable-observation={enableObservation ? 'true' : 'false'}
>
	<canvas class="block size-full" data-logo-canvas aria-label="Incomplete Infinity mark" role="img">Incomplete Infinity</canvas>
	<div class="hidden size-full items-center justify-center data-[theme=dark]:text-white/88 data-[theme=light]:text-black/86 [&:not([hidden])]:flex" data-logo-fallback aria-label="Incomplete Infinity mark fallback" role="img" hidden>
		<span class="block h-[42%] w-[70%] rounded-r-full bg-current" aria-hidden="true"></span>
	</div>
</div>
