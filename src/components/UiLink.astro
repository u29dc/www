---
import { SITE } from '../lib/constants';
import { resolveLinkHoverPreview, type HoverPreviewFit } from '../lib/hover-preview';
import type { LinkIcon, LinkMark } from '../lib/links';

type Props = {
	href?: string;
	icon?: LinkIcon;
	mark?: LinkMark;
	external?: boolean;
	showIcon?: boolean;
	showArrow?: boolean;
	previewMedia?: string;
	previewAlt?: string;
	previewFit?: HoverPreviewFit;
	class?: string;
	target?: string;
	rel?: string;
	[key: string]: unknown;
};

const DEFAULT_LINK_PREVIEW_MEDIA: readonly string[] = [];

const firstDefaultLinkPreviewMedia = (): string | undefined => DEFAULT_LINK_PREVIEW_MEDIA[0];

const {
	href = '#',
	icon,
	mark,
	external,
	showIcon,
	showArrow = true,
	previewMedia,
	previewAlt,
	previewFit,
	class: className,
	target,
	rel,
	...anchorProps
} = Astro.props as Props;

const parseUrl = (value: string): URL | null => {
	try {
		return new URL(value, SITE.url);
	} catch {
		return null;
	}
};

const parsedUrl = parseUrl(href);
const protocol = parsedUrl?.protocol ?? '';
const host = parsedUrl?.hostname.replace(/^www\./, '') ?? '';
const isHttp = protocol === 'http:' || protocol === 'https:';
const isMail = protocol === 'mailto:';
const isExternal = external ?? (isHttp && parsedUrl?.origin !== SITE.url);
const isFootnote = 'data-footnote-ref' in anchorProps || 'data-footnote-backref' in anchorProps;

const iconFromHref = (): LinkIcon => {
	if (isMail) return 'mail';
	if (host === 'youtube.com' || host === 'youtu.be') return 'youtube';
	if (host === 'cal.com') return 'calendar';
	if (host.includes('github.com')) return 'code';
	if (href.endsWith('.pdf') || href.endsWith('.md') || href.endsWith('.txt')) return 'file';
	if (isExternal) return 'globe';
	return 'file';
};

const activeIcon = icon ?? iconFromHref();
const shouldRenderIcon = (showIcon ?? Boolean(icon ?? mark)) && !isFootnote;
const shouldRenderArrow = showArrow && isExternal && !isFootnote;
const targetValue = isExternal ? (target ?? '_blank') : target;
const relValue = isExternal ? Array.from(new Set([rel, 'noopener', 'noreferrer'].filter(Boolean))).join(' ') : rel;
const activePreviewMedia = previewMedia ?? firstDefaultLinkPreviewMedia();
const preview = resolveLinkHoverPreview(activePreviewMedia, {
	...(previewAlt === undefined ? {} : { alt: previewAlt }),
	...(previewFit === undefined ? {} : { fit: previewFit }),
});

const iconPaths: Record<LinkIcon, string[]> = {
	arrow: ['M7 17 17 7', 'M7 7h10v10'],
	calendar: ['M8 2v4', 'M16 2v4', 'M3 10h18', 'M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z'],
	code: ['M16 18l6-6-6-6', 'M8 6l-6 6 6 6', 'M14 4l-4 16'],
	file: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z', 'M14 2v6h6', 'M8 13h8', 'M8 17h5'],
	globe: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z', 'M2 12h20', 'M12 2a15.3 15.3 0 0 1 0 20', 'M12 2a15.3 15.3 0 0 0 0 20'],
	layers: ['M12 2 2 7l10 5 10-5-10-5Z', 'M2 17l10 5 10-5', 'M2 12l10 5 10-5'],
	mail: ['M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', 'm22 6-10 7L2 6'],
	mic: ['M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z', 'M19 10v2a7 7 0 0 1-14 0v-2', 'M12 19v3'],
	play: ['M5 3l14 9-14 9V3Z'],
	rss: ['M4 11a9 9 0 0 1 9 9', 'M4 4a16 16 0 0 1 16 16', 'M5 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z'],
	youtube: [
		'M2.5 7.5A4 4 0 0 1 6 4.8a95 95 0 0 1 12 0 4 4 0 0 1 3.5 2.7 18 18 0 0 1 0 9 4 4 0 0 1-3.5 2.7 95 95 0 0 1-12 0 4 4 0 0 1-3.5-2.7 18 18 0 0 1 0-9Z',
		'M10 9l5 3-5 3V9Z',
	],
};

const markImages: Partial<Record<LinkMark, string>> = {
	lotus: '/assets/marks/lotus.webp',
	lusion: '/assets/marks/lusion.webp',
	nohlab: '/assets/marks/nohlab.webp',
	porsche: '/assets/marks/porsche.webp',
	salon: '/assets/marks/salon.webp',
};
---

<span class:list={['ui-link-wrap', className]}>
	<a
		class="ui-link"
		href={href}
		target={targetValue}
		rel={relValue}
		data-hover-preview-target={preview ? 'link' : undefined}
		data-hover-preview-src={preview?.url}
		data-hover-preview-kind={preview?.kind}
		data-hover-preview-ratio={preview?.ratio}
		data-hover-preview-fit={preview?.fit}
		data-hover-preview-alt={preview?.alt}
		{...anchorProps}
	>
		<span class="ui-link__label"><slot /></span>
		{
			shouldRenderIcon && (
				<span class="ui-link__icon" aria-hidden="true">
					{mark ? (
						markImages[mark] ? (
							<img class="ui-link__mark-image" src={markImages[mark]} alt="" width="64" height="64" decoding="async" draggable="false" />
						) : (
							<span class:list={['ui-link__mark', `ui-link__mark--${mark}`]} />
						)
					) : (
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round" focusable="false">
							{iconPaths[activeIcon].map((path) => <path d={path} />)}
						</svg>
					)}
				</span>
			)
		}
		{
			shouldRenderArrow && (
				<svg class="ui-link__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<path d="M7 17 17 7" />
					<path d="M7 7h10v10" />
				</svg>
			)
		}
	</a>
</span>
