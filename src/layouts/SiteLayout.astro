---
import '../styles/app.css';
import { ClientRouter } from 'astro:transitions';
import Guide from '../components/chrome/guide.astro';
import Header from '../components/chrome/header.astro';
import { MEDIA, SITE, SITE_THEME } from '../data/site';

type Props = {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	markdownUrl?: string;
};

const { title = SITE.title, description = SITE.description, ogType = 'website', publishedTime, markdownUrl } = Astro.props;
const rawTheme = SITE_THEME;
const forcedTheme = rawTheme === 'light' || rawTheme === 'dark' ? rawTheme : undefined;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString();
const siteRoute = Astro.url.pathname === '/' ? 'home' : 'detail';
const markdownHref = markdownUrl ? new URL(markdownUrl, SITE.url).toString() : undefined;
const ogImageUrl = new URL(SITE.ogImagePath, SITE.url).toString();
const themeColorLight = SITE.themeColorLight;
const themeColorDark = SITE.themeColorDark;
---

<!doctype html>
<html lang={SITE.lang} data-theme={forcedTheme} data-site-route={siteRoute}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content={description} />
		<meta name="author" content={SITE.creator} />
		<meta name="creator" content={SITE.creator} />
		<meta name="application-name" content={SITE.name} />
		<meta name="keywords" content={SITE.keywords.join(', ')} />
		<meta name="robots" content="index, follow" />
		{
			forcedTheme ? (
				<meta name="theme-color" content={forcedTheme === 'dark' ? themeColorDark : themeColorLight} />
			) : (
				<>
					<meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
					<meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
				</>
			)
		}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMS context" />
		{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title={`${title} markdown`} />}
		<link rel="preconnect" href={MEDIA.baseUrl} crossorigin="anonymous" />
		<link rel="preload" href="/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/geist/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" type="image/x-icon" />
		<link rel="icon" href="/icon-16.png" sizes="16x16" type="image/png" />
		<link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
		<link rel="icon" href="/icon-96.png" sizes="96x96" type="image/png" />
		<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorLight} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content={SITE.ogImageType} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.name} social card`} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={`${SITE.name} social card`} />
		<ClientRouter fallback="swap" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				root.dataset.motion = reduceMotion ? 'reduced' : 'ready';
				root.dataset.siteRoute = window.location.pathname === '/' ? 'home' : 'detail';

				if (!reduceMotion) {
					window.setTimeout(() => {
						if (root.dataset.motionBoot !== 'ready') {
							root.dataset.motion = 'reduced';
						}
					}, 1500);
				}
			})();
		</script>
		<title>{title}</title>
	</head>
	<body class="min-h-dvh">
		<Guide />
		<Header />
		<div data-page-shell>
			<slot />
		</div>
		<script>
			import '../features/logo';
			import '../features/copy';
			import '../features/preview';
			import '../features/media';
			import '../features/motion';
			import '../features/scroll';
		</script>
	</body>
</html>
