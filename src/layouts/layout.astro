---
import '../styles/app.css';
import Guide from '../components/chrome/guide.astro';
import Header from '../components/chrome/header.astro';
import RouteRouter from '../app/systems/router.astro';
import { MEDIA, SITE } from '../data/site';
import sansFont from '../assets/fonts/geist/Geist-Variable.woff2?url';
import monoFont from '../assets/fonts/geist/GeistMono-Variable.woff2?url';
import serifFont from '../assets/fonts/libre-caslon-condensed/LibreCaslonCondensed[wght].woff2?url';
import type { SocialCard } from '../data/cards';

type Props = {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date | undefined;
	socialCard?: SocialCard | undefined;
	markdownUrl?: string;
	robots?: string;
	preconnectMedia?: boolean;
};

const { title = SITE.title, description = SITE.description, ogType = 'website', publishedTime, modifiedTime, socialCard, markdownUrl, robots = 'index, follow', preconnectMedia } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString();
const siteRoute = Astro.url.pathname === '/' ? 'home' : 'detail';
const shouldPreconnectMedia = preconnectMedia ?? siteRoute === 'detail';
const markdownHref = markdownUrl ? new URL(markdownUrl, SITE.url).toString() : undefined;
const ogImageUrl = new URL(socialCard?.image.src ?? SITE.ogImagePath, SITE.url).toString();
const ogImageAlt = socialCard?.alt ?? `${SITE.name} social card`;
const themeColorLight = SITE.themeColorLight;
const themeColorDark = SITE.themeColorDark;
---

<!doctype html>
<html lang={SITE.lang} data-site-route={siteRoute}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content={description} />
		<meta name="author" content={SITE.creator} />
		<meta name="creator" content={SITE.creator} />
		<meta name="application-name" content={SITE.name} />
		<meta name="keywords" content={SITE.keywords.join(', ')} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content={themeColorLight} media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content={themeColorDark} media="(prefers-color-scheme: dark)" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMS context" />
		<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Incomplete Infinity RSS" />
		<link rel="alternate" type="application/feed+json" href="/feed.json" title="Incomplete Infinity JSON Feed" />
		{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title={`${title} markdown`} />}
		{shouldPreconnectMedia && <link rel="preconnect" href={MEDIA.baseUrl} crossorigin="anonymous" />}
		<link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin="anonymous" />
		{siteRoute === 'detail' && <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin="anonymous" />}
		<link rel="manifest" href="/manifest.json" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" type="image/x-icon" />
		<link rel="icon" href="/icon-16.png" sizes="16x16" type="image/png" />
		<link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
		<link rel="icon" href="/icon-96.png" sizes="96x96" type="image/png" />
		<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color={themeColorLight} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content={socialCard ? `image/${socialCard.image.format}` : SITE.ogImageType} />
		<meta property="og:image:width" content={String(socialCard?.image.width ?? 1200)} />
		<meta property="og:image:height" content={String(socialCard?.image.height ?? 630)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<script is:inline src="/boot.js" crossorigin="anonymous"></script>
		<RouteRouter />
		<title>{title}</title>
	</head>
	<body class="min-h-dvh">
		<Guide />
		<Header />
		<div data-page-shell>
			<slot />
		</div>
		<script>
			import '../app/app';
		</script>
	</body>
</html>
