---
import ConnectLine from '../components/ConnectLine.astro';
import TransitionLink from '../components/TransitionLink.astro';
import UiLink from '../components/UiLink.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate, getFragments, getStudies } from '../lib/content';
import { originLinks, protocols, signals } from '../lib/site-content';

const studies = await getStudies();
const fragments = await getFragments();
const showSignals = import.meta.env['PUBLIC_SHOW_SIGNALS'] === 'true';
---

<SiteLayout title="Incomplete Infinity">
	<header class="sticky top-0 z-10 bg-ground/86 px-(--space-page) pt-(--space-6) pb-(--space-5) backdrop-blur-md">
		<nav class="mx-auto flex w-[min(100%,var(--measure-article))] items-center justify-between text-(length:--type-body) font-(--weight-strong) leading-(--leading-body)" aria-label="Primary" data-reveal>
			<UiLink href="/" showIcon={false} showArrow={false}>Incomplete Infinity</UiLink>
		</nav>
	</header>
	<main class="grid gap-(--space-6) px-(--space-page) pt-(--space-7) pb-(--space-9)">
		<section class="mx-auto grid w-[min(100%,var(--measure-article))] gap-(--space-4) pt-(--space-5)" id="origin">
			<p class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted" data-reveal>Origin</p>
			<div class="grid max-w-(--measure-article) gap-(--space-4)" data-reveal-group>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					Most of the technology that will matter in the next decade is going to work. It will be funded, built, tested, deployed. The engineering question is being answered. The question that is not being answered — the one that shapes adoption, trust, policy, and public patience — is how it enters the world. What story surrounds it. Whether people who were not in the room can feel why it deserves belief.
				</p>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					My background started in architecture at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.salon.href} mark={originLinks.salon.mark}>{originLinks.salon.label}</UiLink>, moved through arts & media at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.nohlab.href} mark={originLinks.nohlab.mark}>{originLinks.nohlab.label}</UiLink>, engineering at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.lusion.href} mark={originLinks.lusion.mark}>{originLinks.lusion.label}</UiLink> as well as various startups, and creative direction at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.lotus.href} mark={originLinks.lotus.mark}>{originLinks.lotus.label}</UiLink> during the shift from petrol to electric. What I'm choosing to point that range at now is the structural layer where technical credibility either becomes meaning or doesn't.
				</p>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					<UiLink class="font-(--weight-strong) text-ink" href={originLinks.practice.href} mark={originLinks.practice.mark}>{originLinks.practice.label}</UiLink> is the practice I'm building around that work. The name is deliberate. I'm interested in structures that stay open enough to be entered, precise enough to be trusted, and strange enough to resist becoming another polished surface. Not completeness as closure, but incompleteness as a live architecture: something others can understand, inhabit, and extend.
				</p>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					The work moves between narrative architecture, creative strategy, and design engineering — depending on what the moment actually demands. Sometimes that means finding the sentence underneath the company. Sometimes it means building the artifact that lets people feel a future before they can explain it. Sometimes it means removing work that should never have been made.
				</p>
			</div>
		</section>

		<section class="mx-auto grid w-[min(100%,var(--measure-article))] gap-(--space-4)" id="protocols">
			<div class="grid gap-0.5">
				<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted" data-reveal>Protocols</h2>
			</div>
			<ul class="grid list-none border-t border-edge-soft p-0" data-reveal-group>
				{protocols.map((protocol) => (
					<li class="grid grid-cols-[4rem_minmax(0,1fr)] items-baseline gap-x-(--space-4) gap-y-(--space-1) border-b border-edge-soft py-(--space-2) max-[42rem]:grid-cols-1 max-[42rem]:gap-(--space-1)">
						<div class="flex items-baseline gap-(--space-2) max-[42rem]:flex-wrap">
							<span class="font-mono text-(length:--type-label) font-(--weight-strong) leading-(--leading-label) text-ink">{protocol.name}</span>
							<span class="hidden font-mono text-(length:--type-label) leading-(--leading-label) tabular-nums text-muted max-[42rem]:inline">{protocol.meta}</span>
						</div>
						<p class="text-right font-mono text-(length:--type-label) leading-(--leading-label) whitespace-nowrap text-muted max-[42rem]:text-left max-[42rem]:whitespace-normal">{protocol.description}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="mx-auto grid w-[min(100%,var(--measure-article))] gap-(--space-4)" id="studies">
			<div class="grid gap-0.5">
				<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted" data-reveal>Artifacts / Studies</h2>
			</div>
			<ul class="grid list-none border-t border-edge-soft p-0" data-reveal-group>
				{studies.map((entry) => (
					<li>
						<TransitionLink class="group grid grid-cols-[minmax(0,1fr)_max-content] items-baseline gap-(--space-4) border-b border-edge-soft py-(--space-2) text-current no-underline opacity-100 transition-opacity duration-(--duration-quick) ease-(--ease-settle) touch-manipulation hover:opacity-72 max-[42rem]:grid-cols-1 max-[42rem]:gap-(--space-1)" href={`/${entry.data.slug}`}>
							<span class="font-mono text-(length:--type-label) font-(--weight-strong) leading-(--leading-label) motion-safe:transition-transform motion-safe:duration-(--duration-quick) motion-safe:ease-(--ease-settle) motion-safe:group-hover:translate-x-1">{entry.data.title}</span>
							<span class="text-right font-mono text-(length:--type-label) leading-(--leading-label) tabular-nums text-muted max-[42rem]:text-left">{entry.data.client}</span>
						</TransitionLink>
					</li>
				))}
			</ul>
		</section>

		<section class="mx-auto grid w-[min(100%,var(--measure-article))] gap-(--space-4)" id="fragments">
			<div class="grid gap-0.5">
				<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted" data-reveal>Artifacts / Fragments</h2>
			</div>
			<ul class="grid list-none border-t border-edge-soft p-0" data-reveal-group>
				{fragments.map((entry) => (
					<li>
						<TransitionLink class="group grid grid-cols-[minmax(0,1fr)_max-content] items-baseline gap-(--space-4) border-b border-edge-soft py-(--space-2) text-current no-underline opacity-100 transition-opacity duration-(--duration-quick) ease-(--ease-settle) touch-manipulation hover:opacity-72 max-[42rem]:grid-cols-1 max-[42rem]:gap-(--space-1)" href={`/${entry.data.slug}`}>
							<span class="font-mono text-(length:--type-label) font-(--weight-strong) leading-(--leading-label) motion-safe:transition-transform motion-safe:duration-(--duration-quick) motion-safe:ease-(--ease-settle) motion-safe:group-hover:translate-x-1">{entry.data.title}</span>
							<span class="text-right font-mono text-(length:--type-label) leading-(--leading-label) tabular-nums text-muted max-[42rem]:text-left">{formatDate(entry.data.date)}</span>
						</TransitionLink>
					</li>
				))}
			</ul>
		</section>

		{
			showSignals && signals.length > 0 && (
					<section class="mx-auto grid w-[min(100%,var(--measure-article))] gap-(--space-4)" id="signals">
						<div class="grid gap-0.5">
							<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted" data-reveal>Signals</h2>
						</div>
						<ul class="grid list-none border-t border-edge-soft p-0" data-reveal-group>
							{signals.map((signal) => (
								<li class="grid gap-(--space-1) border-b border-edge-soft py-(--space-2)">
								<UiLink class="w-fit font-sans text-(length:--type-body) font-(--weight-strong)" href={signal.href}>
									{signal.label}
								</UiLink>
								{signal.meta && <span class="font-sans text-(length:--type-body) leading-(--leading-label) tabular-nums text-muted">{signal.meta}</span>}
							</li>
						))}
					</ul>
				</section>
			)
		}

		<div data-reveal>
			<ConnectLine />
		</div>
	</main>
</SiteLayout>
