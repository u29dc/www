---
import ConnectLine from '../components/ConnectLine.astro';
import TransitionLink from '../components/TransitionLink.astro';
import UiLink from '../components/UiLink.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatDate, getFragments, getStudies } from '../lib/content';
import { resolveArtifactHoverPreview } from '../lib/hover-preview';
import { originLinks, protocols, signals } from '../lib/site-content';

const studies = await getStudies();
const fragments = await getFragments();
const studyRows = studies.map((entry) => ({ entry, preview: resolveArtifactHoverPreview(entry) }));
const fragmentRows = fragments.map((entry) => ({ entry, preview: resolveArtifactHoverPreview(entry) }));
const showSignals = signals.length > 0;
---

<SiteLayout title="Incomplete Infinity">
	<main class="layout-grid gap-y-(--space-6) pt-(--space-7) pb-(--space-9)">
		<section class="layout-lane grid gap-(--space-4) pt-(--space-5)" id="origin" data-reveal>
			<p class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted">Origin</p>
			<div class="grid max-w-(--measure-article) gap-(--space-4)">
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					Most of the technology that will matter in the next decade is already becoming possible. The machines will run. The tech will work. The prototypes will become products. What remains is the passage into the world: belief, adoption, permission, memory, demand. A future can be engineered and still fail to become imaginable to the people who have to fund it, buy it, work on it, regulate it, defend it, or live beside it.
				</p>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					I have spent the last decade working around that passage: from architecture at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.salon.href} mark={originLinks.salon.mark}>{originLinks.salon.label}</UiLink> to arts and media at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.nohlab.href} mark={originLinks.nohlab.mark}>{originLinks.nohlab.label}</UiLink>, creative engineering at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.lusion.href} mark={originLinks.lusion.mark}>{originLinks.lusion.label}</UiLink> and <UiLink class="font-(--weight-strong) text-ink" href={originLinks.artificialRome.href}>{originLinks.artificialRome.label}</UiLink>, cultural and immersive projects across <UiLink class="font-(--weight-strong) text-ink" href={originLinks.porsche.href} mark={originLinks.porsche.mark}>{originLinks.porsche.label}</UiLink>, <UiLink class="font-(--weight-strong) text-ink" href={originLinks.outernet.href}>{originLinks.outernet.label}</UiLink>, the <UiLink class="font-(--weight-strong) text-ink" href={originLinks.ntmofa.href}>{originLinks.ntmofa.label}</UiLink>, <UiLink class="font-(--weight-strong) text-ink" href={originLinks.akbankSanat.href}>{originLinks.akbankSanat.label}</UiLink>, and <UiLink class="font-(--weight-strong) text-ink" href={originLinks.battersea.href}>{originLinks.battersea.label}</UiLink>, then creative direction at <UiLink class="font-(--weight-strong) text-ink" href={originLinks.lotus.href} mark={originLinks.lotus.mark}>{originLinks.lotus.label}</UiLink> during the shift from petrol to electric. Different rooms, different mediums, same pressure: something difficult trying to become visible without becoming smaller.
				</p>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					I am narrowing that range now through <UiLink class="font-(--weight-strong) text-ink" href={originLinks.practice.href} mark={originLinks.practice.mark}>{originLinks.practice.label}</UiLink>, for companies whose work is too consequential to remain trapped inside technical explanation. Energy, climate, robotics: fields where the proof is hard-won, but proof alone rarely carries far enough. The work is narrative architecture, creative strategy, and proof-making for the fragile passage between what has been built and what the world is ready to believe.
				</p>
				<p class="text-(length:--type-body-lg) leading-(--leading-body) text-muted">
					The name is deliberate. Complete systems close. Incomplete ones invite participation. I am interested in structures open enough to be entered, precise enough to be trusted, and strange enough to resist becoming another polished surface. Structures that can hold a technical claim, a commercial decision, and a human reason for caring at the same time.
				</p>
			</div>
		</section>

		<section class="layout-lane grid gap-(--space-4)" id="protocols" data-reveal>
			<div class="grid gap-0.5">
				<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted">Protocols</h2>
			</div>
			<ul class="grid list-none border-t border-edge-soft p-0">
				{protocols.map((protocol) => (
					<li class="grid grid-cols-[9.25rem_minmax(0,1fr)] items-baseline gap-x-(--space-4) gap-y-(--space-1) border-b border-edge-soft py-(--space-2) max-[42rem]:grid-cols-1 max-[42rem]:gap-(--space-1)">
						<div class="grid grid-cols-[3.25rem_minmax(0,1fr)] items-baseline gap-x-(--space-2)">
							<span class="font-mono text-(length:--type-label) font-(--weight-strong) leading-(--leading-label) text-ink">{protocol.name}</span>
							<span class="font-mono text-(length:--type-label) leading-(--leading-label) tabular-nums whitespace-nowrap text-muted">{protocol.meta}</span>
						</div>
						<p class="min-w-0 text-right font-mono text-(length:--type-label) leading-(--leading-label) text-muted max-[42rem]:text-left">{protocol.description}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="layout-lane grid gap-(--space-4)" id="studies" data-hover-preview-scope="artifacts" data-reveal>
			<div class="grid gap-0.5">
				<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted">Artifacts / Studies</h2>
			</div>
			<ul class="grid list-none border-t border-edge-soft p-0">
				{studyRows.map(({ entry, preview }) => (
					<li>
						<TransitionLink
							class="artifact-row group grid grid-cols-[minmax(0,1fr)_max-content] items-baseline gap-(--space-4) border-b border-edge-soft py-(--space-2) text-current no-underline transition-opacity duration-(--duration-quick) ease-(--ease-settle) touch-manipulation max-[42rem]:grid-cols-1 max-[42rem]:gap-(--space-1)"
							href={`/${entry.data.slug}`}
							data-hover-preview-target="artifact"
							data-hover-preview-src={preview.url}
							data-hover-preview-kind={preview.kind}
							data-hover-preview-ratio={preview.ratio}
							data-hover-preview-fit={preview.fit}
							data-hover-preview-alt={preview.alt}
						>
							<span class="font-mono text-(length:--type-label) font-(--weight-strong) leading-(--leading-label) motion-safe:transition-transform motion-safe:duration-(--duration-quick) motion-safe:ease-(--ease-settle) motion-safe:group-hover:translate-x-1">{entry.data.title}</span>
							<span class="text-right font-mono text-(length:--type-label) leading-(--leading-label) tabular-nums text-muted max-[42rem]:text-left">{entry.data.client}</span>
						</TransitionLink>
					</li>
				))}
			</ul>
		</section>

		<section class="layout-lane grid gap-(--space-4)" id="fragments" data-hover-preview-scope="artifacts" data-reveal>
			<div class="grid gap-0.5">
				<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted">Artifacts / Fragments</h2>
			</div>
			<ul class="grid list-none border-t border-edge-soft p-0">
				{fragmentRows.map(({ entry, preview }) => (
					<li>
						<TransitionLink
							class="artifact-row group grid grid-cols-[minmax(0,1fr)_max-content] items-baseline gap-(--space-4) border-b border-edge-soft py-(--space-2) text-current no-underline transition-opacity duration-(--duration-quick) ease-(--ease-settle) touch-manipulation max-[42rem]:grid-cols-1 max-[42rem]:gap-(--space-1)"
							href={`/${entry.data.slug}`}
							data-hover-preview-target="artifact"
							data-hover-preview-src={preview.url}
							data-hover-preview-kind={preview.kind}
							data-hover-preview-ratio={preview.ratio}
							data-hover-preview-fit={preview.fit}
							data-hover-preview-alt={preview.alt}
						>
							<span class="font-mono text-(length:--type-label) font-(--weight-strong) leading-(--leading-label) motion-safe:transition-transform motion-safe:duration-(--duration-quick) motion-safe:ease-(--ease-settle) motion-safe:group-hover:translate-x-1">{entry.data.title}</span>
							<span class="text-right font-mono text-(length:--type-label) leading-(--leading-label) tabular-nums text-muted max-[42rem]:text-left">{formatDate(entry.data.date)}</span>
						</TransitionLink>
					</li>
				))}
			</ul>
		</section>

		{
			showSignals && signals.length > 0 && (
					<section class="layout-lane grid gap-(--space-4)" id="signals" data-reveal>
						<div class="grid gap-0.5">
							<h2 class="text-(length:--type-body) font-(--weight-strong) leading-(--leading-body) text-muted">Signals</h2>
						</div>
						<ul class="grid list-none border-t border-edge-soft p-0">
							{signals.map((signal) => (
								<li class="grid gap-(--space-1) border-b border-edge-soft py-(--space-2)">
								<UiLink class="w-fit font-sans text-(length:--type-body) font-(--weight-strong)" href={signal.href}>
									{signal.label}
								</UiLink>
								{signal.meta && <span class="font-sans text-(length:--type-body) leading-(--leading-label) tabular-nums text-muted">{signal.meta}</span>}
							</li>
						))}
					</ul>
				</section>
			)
		}

		<div class="layout-lane" data-reveal>
			<ConnectLine />
		</div>
	</main>
</SiteLayout>
