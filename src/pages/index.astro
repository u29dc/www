---
import ArtifactList from '../components/artifacts/list.astro';
import Connect from '../components/chrome/connect.astro';
import Origin from '../components/home/origin.astro';
import Protocols from '../components/home/protocols.astro';
import Signals from '../components/home/signals.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getFragments, getStudies } from '../lib/artifacts';

const studies = await getStudies();
const fragments = await getFragments();
---

<SiteLayout title="Incomplete Infinity">
	<main class="layout-grid gap-y-(--space-6) py-(--space-6)" data-content-panel>
		<Origin />
		<Protocols />
		<ArtifactList id="studies" title="Artifacts / Studies" entries={studies} />
		<ArtifactList id="fragments" title="Artifacts / Fragments" entries={fragments} />
		<Signals />
		<div class="layout-lane" data-reveal>
			<Connect />
		</div>
	</main>
</SiteLayout>
