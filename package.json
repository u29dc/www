{
	"name": "www",
	"version": "2.1.2",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/u29dc/www.git"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "bunx astro dev",
		"build": "bunx astro build",
		"preview": "bunx astro preview",
		"util:format": "bunx oxfmt . --write --no-error-on-unmatched-pattern && bunx oxfmt . --check --no-error-on-unmatched-pattern",
		"util:lint": "bunx oxlint src astro.config.mjs commitlint.config.js lint-staged.config.js --fix --deny-warnings --no-error-on-unmatched-pattern",
		"util:clean": "rm -rf .astro dist node_modules/.vite .wrangler *.tsbuildinfo",
		"util:check": "bun run util:format && bun run util:lint && bunx astro check && bunx astro build"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "14.0.0-alpha.0",
		"@astrojs/mdx": "6.0.0-alpha.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@tailwindcss/vite": "^4.3.0",
		"astro": "7.0.0-alpha.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"oxlint-tsgolint": "^0.23.0",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.93.1"
	},
	"dependencies": {
		"lenis": "^1.3.23"
	}
}
