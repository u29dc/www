{
	"name": "@u29dc/www",
	"description": "We turn complex futures into decision-grade narratives and public prototypes",
	"author": "Han (https://u29dc.com)",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "https://github.com/u29dc/www"
	},
	"homepage": "https://u29dc.com",
	"version": "2.1.2",
	"private": true,
	"type": "module",
	"scripts": {
		"setup--------------------------------": "",
		"prepare": "husky",
		"dev----------------------------------": "",
		"dev": "bunx --bun svelte-kit sync && bunx --bun vite dev",
		"build--------------------------------": "",
		"build": "bunx --bun svelte-kit sync && bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"code---------------------------------": "",
		"util:format": "bunx biome format --write .",
		"util:lint": "bunx biome check --max-diagnostics=500 .",
		"util:lint:fix": "bunx biome check --fix --max-diagnostics=500 .",
		"util:lint:staged": "bunx lint-staged",
		"util:types": "bunx --bun svelte-kit sync && bunx tsc --noEmit",
		"utils--------------------------------": "",
		"util:clean": "rm -rf .svelte-kit build node_modules/.vite .turbo *.tsbuildinfo",
		"util:check": "bun run util:format && bun run util:lint && bun run util:types",
		"perf---------------------------------": "",
		"perf:lighthouse": "CHROME_PATH=\"/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge\" bunx lighthouse http://localhost:4173 --output json --output html --output-path ./tmp/lighthouse.report --chrome-flags='--headless --no-sandbox'",
		"release------------------------------": "",
		"semantic-release": "bunx semantic-release"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.2",
		"@semantic-release/npm": "^13.1.3",
		"@semantic-release/release-notes-generator": "^14.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/js-yaml": "^4.0.9",
		"@typescript-eslint/types": "^8.50.1",
		"husky": "^9.1.7",
		"lighthouse": "^13.0.1",
		"lint-staged": "^16.2.7",
		"mdsvex": "^0.12.6",
		"semantic-release": "^25.0.2",
		"svelte": "^5.46.1",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.0"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"hastscript": "^9.0.1",
		"js-yaml": "^4.1.1",
		"lucide-svelte": "^0.562.0",
		"pino": "^10.1.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"zod": "^4.2.1"
	}
}
