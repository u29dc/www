{
	"name": "www",
	"version": "2.1.2",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/u29dc/www.git"
	},
	"scripts": {
		"init---------------------------------": "",
		"prepare": "husky",
		"dev----------------------------------": "",
		"dev": "bunx --bun svelte-kit sync && bunx --bun vite dev",
		"build": "bunx --bun svelte-kit sync && bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"check--------------------------------": "",
		"util:format": "bunx biome format --write .",
		"util:lint": "bunx biome check --max-diagnostics=500 .",
		"util:lint:fix": "bunx biome check --fix --max-diagnostics=500 .",
		"util:lint:staged": "bunx lint-staged",
		"util:types": "bunx --bun svelte-kit sync && tsgo --noEmit",
		"util:clean": "rm -rf .svelte-kit build node_modules/.vite .turbo *.tsbuildinfo",
		"util:check": "STATUS=0; bun run util:format || STATUS=1; bun run util:lint || STATUS=1; bun run util:types || STATUS=1; exit $STATUS",
		"perf:lighthouse": "CHROME_PATH=\"/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge\" bunx lighthouse http://localhost:4173 --output json --output html --output-path ./tmp/lighthouse.report --chrome-flags='--headless --no-sandbox'"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@commitlint/cli": "^20.3.0",
		"@commitlint/config-conventional": "^20.3.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.49.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.3",
		"@tailwindcss/vite": "^4.1.18",
		"@types/js-yaml": "^4.0.9",
		"@typescript-eslint/types": "^8.52.0",
		"husky": "^9.1.7",
		"lighthouse": "^13.0.1",
		"lint-staged": "^16.2.7",
		"mdsvex": "^0.12.6",
		"svelte": "^5.46.1",
		"tailwindcss": "^4.1.18",
		"@typescript/native-preview": "^7.0.0-dev.20260107.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"hastscript": "^9.0.1",
		"js-yaml": "^4.1.1",
		"lucide-svelte": "^0.562.0",
		"pino": "^10.1.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"zod": "^4.3.5"
	}
}
