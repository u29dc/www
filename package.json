{
	"name": "www",
	"version": "3.0.0",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/u29dc/www.git"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "bunx astro dev",
		"astro:build": "bunx astro build",
		"build": "bun run astro:build && bun run util:minify",
		"preview": "bunx astro preview",
		"deploy": "bun run util:check && bunx wrangler deploy",
		"update": "bun update --latest && bun add --dev astro@alpha @astrojs/cloudflare@alpha @astrojs/mdx@alpha && bun install",
		"util:format": "bunx oxfmt . --write --no-error-on-unmatched-pattern && bunx oxfmt . --check --no-error-on-unmatched-pattern",
		"util:lint": "bunx oxlint src scripts astro.config.ts commitlint.config.js lint-staged.config.js --fix --deny-warnings --no-error-on-unmatched-pattern",
		"util:minify": "bun scripts/minify.ts",
		"util:clean": "rm -rf .astro dist node_modules/.vite .wrangler *.tsbuildinfo",
		"util:check": "bun run util:format && bun run util:lint && bunx astro check && bun run build"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^14.0.0-alpha.1",
		"@astrojs/mdx": "^6.0.0-alpha.1",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/config-conventional": "^21.1.0",
		"@lucide/astro": "^1.21.0",
		"@minify-html/node": "^0.18.1",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^26.0.1",
		"astro": "^7.0.0-alpha.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"oxlint-tsgolint": "^0.23.0",
		"parse5": "^8.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"rolldown": "^1.1.3",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"wrangler": "^4.105.0"
	}
}
