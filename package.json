{
	"name": "www",
	"version": "2.1.2",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/u29dc/www.git"
	},
	"scripts": {
		"init---------------------------------": "",
		"prepare": "husky",
		"dev----------------------------------": "",
		"dev": "bunx --bun svelte-kit sync && bunx --bun vite dev",
		"build": "bunx --bun svelte-kit sync && bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"check--------------------------------": "",
		"util:format": "bunx biome format --write .",
		"util:lint": "bunx biome check --max-diagnostics=500 .",
		"util:lint:fix": "bunx biome check --fix --max-diagnostics=500 .",
		"util:lint:staged": "bunx lint-staged",
		"util:types": "bunx --bun svelte-kit sync && bunx --bun tsgo --noEmit",
		"util:types:svelte": "bunx svelte-check-rs --tsconfig ./tsconfig.svelte.json",
		"util:types:zvelte": "zvelte-check --workspace ./src --tsconfig ./tsconfig.json",
		"util:clean": "rm -rf .svelte-kit build node_modules/.vite .wrangler *.tsbuildinfo",
		"util:check": "STATUS=0; bun run util:format || STATUS=1; bun run util:lint || STATUS=1; bun run util:types || STATUS=1; bun run util:types:svelte || STATUS=1; bun run util:types:zvelte || STATUS=1; exit $STATUS"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@commitlint/cli": "^20.4.2",
		"@commitlint/config-conventional": "^20.4.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@types/js-yaml": "^4.0.9",
		"@typescript-eslint/types": "^8.56.1",
		"@typescript/native-preview": "^7.0.0-dev.20260228.1",
		"husky": "^9.1.7",
		"lighthouse": "^13.0.3",
		"lint-staged": "^16.3.0",
		"mdsvex": "^0.12.6",
		"svelte": "^5.53.6",
		"svelte-check-rs": "^0.9.5",
		"tailwindcss": "^4.2.1",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@lucide/svelte": "^0.575.0",
		"gray-matter": "^4.0.3",
		"hastscript": "^9.0.1",
		"js-yaml": "^4.1.1",
		"lenis": "^1.3.17",
		"pino": "^10.3.1",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"zod": "^4.3.6"
	}
}
